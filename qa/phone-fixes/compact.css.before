/* Compact corner controls. Loaded after legacy responsive styles. */
.game-header,.mobile-device .game-header{left:auto;right:calc(10px + env(safe-area-inset-right));top:calc(6px + env(safe-area-inset-top));width:270px;max-width:calc(100% - 115px - env(safe-area-inset-left) - env(safe-area-inset-right));margin:0;padding:3px 6px;border-radius:12px;background:#173d34df;color:#fff4dd;box-shadow:none}
.status-line,.mobile-device .status-line{display:grid;grid-template-columns:minmax(0,1fr) auto 44px 44px;grid-template-rows:22px 22px;gap:0 4px;height:44px}
.brand{grid-column:1;grid-row:1;min-width:0}.brand span{font-size:11px;font-weight:650;max-width:100%;white-space:nowrap}#clock{grid-column:1 / 3;grid-row:2;font-size:10px!important;margin:0!important}#cash{grid-column:2;grid-row:1;font-size:11px}.status-line button{grid-row:1 / 3;min-width:44px;min-height:44px;background:transparent;color:inherit;border-radius:8px;padding:0;font-size:11px}.corner-phone{grid-column:3}#menu-toggle{grid-column:4;font-size:21px}.status-line #needs-toggle{display:none}
#quick-menu{position:absolute;right:0;top:54px;display:grid;grid-template-columns:1fr 1fr;width:222px;padding:6px;background:#faf6e8;color:#173d34;border-radius:12px;box-shadow:0 3px 14px #173d3430;border:0}#quick-menu button{min-height:44px}#quick-menu #help{min-width:44px}
.objective-panel,.mobile-device .objective-panel{left:calc(12px + env(safe-area-inset-left));right:auto;top:calc(104px + env(safe-area-inset-top));transform:none;width:min(230px,32vw);text-align:left;pointer-events:auto;font-size:11px;color:#fff6df}.objective-panel summary{display:flex;gap:6px;align-items:center;cursor:pointer;min-height:44px;padding:4px 8px;border-radius:9px;background:#173d34c9;list-style:none}.objective-panel summary:before{content:'▸'}.objective-panel[open] summary:before{content:'▾'}#objective-short{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10px;opacity:.85}.objective-panel[open] #objective-short{display:none}.objective-panel button{min-height:44px;text-align:left;padding:8px;font-size:11px}#waypoint{font-size:10px;color:#173d34;width:100%;min-height:0}
#minimap,.mobile-device #minimap{left:calc(12px + env(safe-area-inset-left));right:auto;top:calc(8px + env(safe-area-inset-top));bottom:auto;width:84px;height:84px}
#hud,.mobile-device .needs-panel{top:calc(62px + env(safe-area-inset-top));right:calc(10px + env(safe-area-inset-right));left:auto;max-height:calc(100% - 78px - env(safe-area-inset-top) - env(safe-area-inset-bottom))}
.activity,.mobile-device .activity{bottom:calc(14px + env(safe-area-inset-bottom));width:min(360px,48vw);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 8px;padding:3px 8px;border-radius:9px}.activity strong{align-self:center;font-size:11px}.activity div{grid-column:2;grid-row:1;gap:4px}.activity progress{grid-column:1 / 3;grid-row:2;height:4px;margin:0}.activity button{min-height:44px;padding:5px 9px;font-size:11px}#finishactivity{display:none}
#home-strip,#service-strip,#destination-ui{bottom:calc(14px + env(safe-area-inset-bottom));border-radius:9px;padding:3px 7px;width:min(390px,48vw)}.home-strip-line strong{font-size:11px}#home-drawer{right:calc(124px + env(safe-area-inset-right));bottom:calc(76px + env(safe-area-inset-bottom));width:min(300px,40vw);max-height:58%;padding:8px}#home-strip progress{height:4px}#service-status{font-size:11px}#service-buttons button{font-size:11px}
#street-card{top:auto;bottom:calc(76px + env(safe-area-inset-bottom));right:calc(124px + env(safe-area-inset-right));width:min(290px,40vw);max-height:58%;padding:9px;font-size:12px}#street-card p{font-size:12px}#street-card strong,#street-card small{margin-bottom:5px}#street-card button{font-size:12px;margin:2px;min-height:44px}#street-close{width:44px;height:44px;top:0;right:0}
#toast,.mobile-device #toast{top:auto;bottom:calc(68px + env(safe-area-inset-bottom));max-width:42vw;font-size:11px;pointer-events:none}.mobile-device .effects-setting{display:flex}.camera-hint{display:none}
@media(orientation:portrait){.game-header,.mobile-device .game-header{max-width:calc(100% - 20px - env(safe-area-inset-left) - env(safe-area-inset-right));width:270px}#minimap,.mobile-device #minimap{top:122px;width:70px;height:70px}.objective-panel,.mobile-device .objective-panel{top:200px;width:180px}#street-card,#home-drawer{right:12px;width:80vw;max-height:44%}#rotate-screen{top:calc(62px + env(safe-area-inset-top));font-size:12px;padding:6px 8px}}

.food-thumb{width:48px;height:48px;object-fit:contain;border-radius:9px;flex-shrink:0;float:left;margin:0 8px 4px 0}.food-menu-card .food-thumb{width:52px;height:52px;grid-row:1/3}.home-stock-row,.home-recipe{display:flow-root}.food-mini-card{display:flex;align-items:center;text-align:left}.food-mini-card .food-thumb{float:none}.home-recipe small{font-size:10px}.home-recipe button{font-size:11px!important}.meal-row{flex-wrap:wrap;padding:7px 0}.meal-row>span{flex:1;min-width:150px}.meal-row button{min-width:70px;flex:1}#meal-actions{position:absolute;z-index:11;bottom:calc(12px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(370px,48vw);border-radius:10px;background:#173d34e6;color:#fff4dd;padding:5px 7px;font-size:11px}#meal-actions strong{display:block;margin-bottom:3px}#meal-actions button{min-height:44px;border-radius:7px;margin:2px;padding:5px 8px;font-size:11px}#meal-actions .food-thumb{width:42px;height:42px}#dialogue-panel{position:absolute;z-index:19;left:calc(14px + env(safe-area-inset-left));bottom:calc(150px + env(safe-area-inset-bottom));width:min(270px,34vw);max-height:55%;overflow:auto;background:#fff5e9f2;border-radius:12px;padding:9px 10px;color:#234638;font-size:12px}#dialogue-panel strong{display:block;padding-right:36px;font-size:11px}#dialogue-panel p{margin:6px 0;line-height:1.4}#dialogue-close{position:absolute;right:0;top:0;width:44px;font-size:22px;background:transparent}#dialogue-choices{display:flex;flex-wrap:wrap;gap:4px}#dialogue-choices button{min-height:44px;flex:1 1 45%;padding:6px;border-radius:7px;background:#dce6d5;font-size:11px}.dialogue-text{font-size:10px;min-height:44px;background:transparent;text-decoration:underline}#dialogue-choices:empty{display:none}@media(orientation:portrait){#dialogue-panel{bottom:180px;width:75vw;max-height:45%}}
