import * as T from './vendor/three.module.js';
import {activeMeals,heldMeal,tableMeal,INGREDIENTS,kitchenActive} from './home-life.js';
import {handPoint} from './home-motion.js';
export function createHomeProps(scene,interior){
 const owned=[],mats=new Map();function mat(c){if(!mats.has(c)){const m=new T.MeshStandardMaterial({color:c,roughness:.8});mats.set(c,m);owned.push(m);}return mats.get(c);}
 function box(w,h,d,c,x=0,y=0,z=0,parent){const g=new T.BoxGeometry(w,h,d);owned.push(g);const m=new T.Mesh(g,mat(c));m.position.set(x,y,z);parent.add(m);return m;}
 function cyl(r,h,c,x=0,y=0,z=0,parent){const g=new T.CylinderGeometry(r,r,h,12);owned.push(g);const m=new T.Mesh(g,mat(c));m.position.set(x,y,z);parent.add(m);return m;}
 const carry=new T.Group();carry.name='carried-food-package';scene.add(carry);box(.42,.23,.32,'#d9bb83',0,-.15,0,carry);box(.43,.025,.33,'#eee0bc',0,-.025,0,carry);for(const x of [-.13,.13])box(.025,.12,.025,'#866844',x,.04,0,carry);box(.28,.025,.025,'#866844',0,.1,0,carry);
 const carryPlate=new T.Group();carry.add(carryPlate);cyl(.26,.035,'#ede5cc',0,-.1,0,carryPlate);const carryFood=cyl(.21,.07,'#ba6d3c',0,-.05,0,carryPlate);const packageParts=carry.children.filter(o=>o!==carryPlate);
 const meal=new T.Group();meal.name='physical-table-meal';meal.position.set(-2.2,1.15,.4);interior.room.add(meal);cyl(.29,.04,'#ede5cc',0,.025,0,meal);const food=cyl(.235,.075,'#ba6d3c',0,.08,0,meal);const lid=box(.58,.025,.55,'#d9bb83',0,.14,0,meal);
 const utensil=new T.Group();scene.add(utensil);utensil.name='held-action-utensil';box(.025,.025,.32,'#babeb0',0,0,.08,utensil);const bowl=cyl(.055,.015,'#cdd1bd',0,0,.27,utensil);const morsel=cyl(.035,.035,'#bc6f39',0,.03,.27,utensil);

 function mealDetails(parent,baseY){const grainsGeo=new T.SphereGeometry(.018,5,3),slicesGeo=new T.CylinderGeometry(.047,.047,.017,8);owned.push(grainsGeo,slicesGeo);const grains=new T.InstancedMesh(grainsGeo,mat('#e3a057'),32),slices=new T.InstancedMesh(slicesGeo,mat('#dca44c'),4),dummy=new T.Object3D();grains.frustumCulled=false;slices.frustumCulled=false;parent.add(grains,slices);let stamp='';return m=>{const key=m?.recipe+':'+m?.bites;if(key===stamp)return;stamp=key;const beans=m?.recipe.includes('beans'),yam=m?.recipe==='pepper-yam';grains.material=mat(beans?'#a87b4b':yam?'#e8c993':'#e3a057');const count=Math.round(32*(1-(m?.bites||0)/4));grains.count=count;for(let i=0;i<count;i++){const angle=i*2.4,r=.17*Math.sqrt((i+.5)/32);dummy.position.set(Math.cos(angle)*r,baseY+.048,Math.sin(angle)*r);dummy.rotation.set(0,i*1.3,0);dummy.scale.set(beans?1:yam?1.8:1.1,beans?.7:yam?1.3:.4,beans?.7:yam?1.6:.42);dummy.updateMatrix();grains.setMatrixAt(i,dummy.matrix);}grains.instanceMatrix.needsUpdate=true;const plantain=['jollof','beans','home-beans'].includes(m?.recipe);slices.count=plantain?Math.max(0,4-(m?.bites||0)):0;for(let i=0;i<slices.count;i++){dummy.position.set(-.13+i*.085,baseY+.04,.16);dummy.rotation.set(0,-.5,0);dummy.scale.set(1.2,1,.7);dummy.updateMatrix();slices.setMatrixAt(i,dummy.matrix);}slices.instanceMatrix.needsUpdate=true;};}
 const detailCarry=mealDetails(carryPlate,-.05),detailTable=mealDetails(meal,.08);

 const contents={};for(const id of ['fridge','cupboard']){contents[id]=[];for(let i=0;i<8;i++){const m=box(.13,.2,.12,id==='fridge'?'#bd6840':'#d6bd8a',-.27+(i%4)*.18,.7+Math.floor(i/4)*.45,0,interior.refs[id].contents);contents[id].push(m);}}
 return {carry,meal,utensil,update(s,player,view,action,openStorage){const held=heldMeal(s);const ingredients=kitchenActive(s)&&!s.homeLife.job.spent&&Object.keys(s.homeLife.job.reserved).length>0;carry.visible=!!(held||ingredients)&&player.visible&&!action;detailCarry(held);carryPlate.visible=!!held?.opened;packageParts.forEach(o=>o.visible=!held?.opened);if(held){carryFood.scale.setScalar(Math.max(.15,1-held.bites/4));carryFood.material=mat(held.recipe.includes('beans')?'#80613e':'#ba6d3c');}if(carry.visible){carry.position.copy(handPoint(player)).add(new T.Vector3(0,-.1,0));carry.quaternion.copy(player.getWorldQuaternion(new T.Quaternion()));}const table=tableMeal(s);meal.visible=view==='home'&&!!table;if(table){detailTable(table);food.scale.setScalar(Math.max(.15,1-table.bites/4));food.material=mat(table.recipe.includes('beans')?'#80613e':'#ba6d3c');lid.visible=!table.opened;lid.rotation.x=action?.kind==='open-meal'?-Math.min(1,action.elapsed)*1.5:0;lid.position.y=.14+(action?.kind==='open-meal'?Math.min(1,action.elapsed)*.18:0);}
 utensil.visible=view==='home'&&['eat','prepare','stir','cook','plate'].includes(action?.kind);if(utensil.visible){utensil.position.copy(handPoint(player));utensil.quaternion.copy(player.getWorldQuaternion(new T.Quaternion()));morsel.visible=action.kind==='eat'&&action.elapsed<1.25;bowl.visible=action.kind!=='prepare';}
 const job=s.homeLife.job;interior.refs.ingredients.visible=view==='home'&&kitchenActive(s)&&['prepare','cook','plate'].includes(job.stage);interior.refs.stew.visible=view==='home'&&kitchenActive(s)&&['cook','plate'].includes(job.stage);if(job)interior.refs.stew.material.color.set(job.recipe==='beans'?'#80613e':'#be673a');
 for(const id of ['fridge','cupboard']){const ref=interior.refs[id];ref.door.visible=openStorage!==id;ref.contents.visible=openStorage===id;const count=Object.values(s.homeLife.ingredients[id]).reduce((a,b)=>a+b,0)+(id==='fridge'?activeMeals(s).filter(m=>m.place==='fridge').length:0);contents[id].forEach((m,i)=>m.visible=i<Math.min(8,count));}},dispose(){carry.removeFromParent();meal.removeFromParent();utensil.removeFromParent();for(const r of owned)r.dispose();}};
}
