import {foodImage,ingredientImage} from './food-images.js';
import * as T from './vendor/three.module.js';
import {HOME_STATIONS} from './home-layout.js';
import {INGREDIENTS,RECIPES,NUTRITION,heldMeal,tableMeal,activeMeals,kitchenActive,carryMeal,placeMeal,openMeal,biteMeal,storeMeal,discardMeal,unpackGroceries,moveIngredient,recipeAvailability,beginRecipe,collectIngredient,prepareRecipe,heatRecipe,stirRecipe,finishRecipeHeat,plateRecipe,cancelRecipe} from './home-life.js';
import {homeMotion,carryMotion} from './home-motion.js';
import {animateCharacter} from './character.js';
import {createHomeProps} from './home-props.js';
export function createHomeExperience({state,scene,interior,player:getPlayer,location,commit,save,toast,stopInput,completeActivity,activityBlock}){
 const $=id=>document.getElementById(id),mealUI=$('meal-actions'),ui=$('home-action-ui'),drawer=$('home-drawer'),strip=$('home-strip'),props=createHomeProps(scene,interior);let action=null,panel=null,lastUI=0,clock=0,audio=null,actionButtonsKey='',mealKey='';
 const near=id=>{const p=HOME_STATIONS[id].stand,q=getPlayer().position;return location()==='home'&&Math.hypot(q.x-p.x,q.z-p.z)<1.2;};
 function sound(on){if(audio)audio.gain.gain.value=on?.028:0;}
 function unlockSound(){if(audio)return;try{const C=globalThis.AudioContext||globalThis.webkitAudioContext;if(!C)return;const context=new C(),buffer=context.createBuffer(1,context.sampleRate,context.sampleRate),data=buffer.getChannelData(0);for(let i=0;i<data.length;i++)data[i]=Math.random()*2-1;const source=context.createBufferSource(),filter=context.createBiquadFilter(),gain=context.createGain();source.buffer=buffer;source.loop=true;filter.type='lowpass';filter.frequency.value=1200;gain.gain.value=0;source.connect(filter);filter.connect(gain);gain.connect(context.destination);source.start();context.resume().catch(()=>{});audio={context,gain,source};}catch{toast('Shower sound is unavailable in this browser.');}}
 function result(r){commit(r);if(r?.ok)refresh();return r?.ok;}
 function closePanel(){panel=null;drawer.classList.add('hidden');drawer.innerHTML='';}
 function openPanel(id,html){stopInput();panel=id;drawer.innerHTML='<button id="home-panel-close" aria-label="Close details">×</button>'+html;drawer.classList.remove('hidden');$('home-panel-close').onclick=closePanel;}
 function finish(){if(!action)return;const done=action;action=null;sound(false);const p=getPlayer();p.position.set(done.stand.x,.16,done.stand.z);p.rotation.set(0,0,0);animateCharacter(p,0,false);interior.activityTick(null,0);strip.classList.add('hidden');if(done.complete)result(done.complete());else save();refresh();}
 function cancel(){if(!action){closePanel();return;}if(action.kind==='wash'){action={kind:'shower-exit',title:'Leaving shower',elapsed:0,duration:1.2,from:getPlayer().position.clone(),stand:action.stand};sound(false);return;}action.complete=null;finish();toast('Activity paused/cancelled. Saved ingredients and meals remain.');}
 function start(kind,title,station,duration,complete){if(action||!near(station))return false;closePanel();stopInput();const p=getPlayer(),stand=HOME_STATIONS[station].stand;action={kind,title,station,elapsed:0,duration,complete,stand:{...stand},from:p.position.clone()};p.position.set(stand.x,.16,stand.z);p.rotation.set(0,Math.PI,0);if(kind==='eat'||kind==='open-meal')p.position.set(-2.2,.16,1.35);if(['prepare','plate','cook'].includes(kind))p.position.set(stand.x,.16,-4.2);if(kind==='study'||kind==='computer')p.position.set(kind==='study'?-.3:1,.16,-4.65);if(kind==='sit')p.position.set(.4,.25,2.1);if(kind==='sleep'){p.position.set(-4.7,1.2,-2.1);p.rotation.set(-Math.PI/2,0,0);}if(kind==='wash')unlockSound();strip.classList.remove('hidden');refresh();return true;}
 function startActivity(id){if(!HOME_STATIONS[id]||!near(id)){toast('Approach the '+(id==='wash'?'shower entrance':id)+'.');return false;}if(id==='cook'||id==='prep'){openStation(id);return true;}if(['fridge','cupboard','table'].includes(id)){openStation(id);return true;}if(id==='wardrobe')return false;if(heldMeal(state)){toast('Place or store the carried meal first.');return true;}const blocked=activityBlock(state,id);if(blocked){toast(blocked);return true;}const title={sleep:'Sleeping',study:'Reading at the desk',computer:'Typing at the computer',wash:'Showering',sit:'Resting on the sofa'}[id];if(!title)return false;
 if(id==='study'){openPanel(id,'<strong>Study focus</strong><select id="home-study-focus"><option value="trader">Trading</option><option value="rider">Dispatch</option><option value="chef">Cooking</option></select><button id="home-read">Sit & read</button>');$('home-study-focus').value=state.studyFocus;$('home-read').onclick=()=>{state.studyFocus=$('home-study-focus').value;start(id,title,id,12,()=>({ok:completeActivity(state,id),message:'Study completed.'}));};return true;}
 start(id,title,id,id==='wash'?11:12,()=>({ok:completeActivity(state,id),message:title+' complete.'}));return true;}
 function refresh(){if(action){$('home-activity-name').textContent=action.title;$('home-remaining').textContent=action.kind==='cook'?Math.max(0,Math.ceil(8-state.homeLife.job.elapsed))+'s simmer · heat '+Math.round(state.homeLife.job.heat):Math.max(0,Math.ceil(action.duration-action.elapsed))+'s';$('home-activity-progress').value=action.kind==='cook'?Math.min(100,state.homeLife.job.elapsed/8*100):action.elapsed/action.duration*100;}const key=(action?.kind||'')+':'+(state.homeLife.job?.stirs||0);if(key===actionButtonsKey){if(action?.kind==='cook'){const j=state.homeLife.job;$('home-stir').disabled=j.sinceStir<2;$('home-finish-cook').disabled=j.elapsed<8||j.green<2||j.stirs<2;}return;}actionButtonsKey=key;$('home-action-buttons').innerHTML='';if(action?.kind==='cook'){const j=state.homeLife.job;$('home-action-buttons').innerHTML='<button id="home-heat-down">Heat −</button><button id="home-stir">Stir</button><button id="home-heat-up">Heat +</button><button id="home-finish-cook">Finish cooking</button>';$('home-stir').disabled=j.sinceStir<2;$('home-finish-cook').disabled=j.elapsed<8||j.green<2||j.stirs<2;const expected=j.stirs;$('home-stir').onclick=()=>result(stirRecipe(state,j.id,expected,location(),getPlayer().position));for(const [id,amount] of [['home-heat-down',-10],['home-heat-up',10]])$(id).onclick=()=>{j.burner=Math.max(0,Math.min(100,j.burner+amount));save();refresh();};$('home-finish-cook').onclick=()=>{if(result(finishRecipeHeat(state,j.id,location(),getPlayer().position)))finish();};}}
 function openStation(id){if(!near(id)){toast('Walk closer to the '+id+'.');return;}if(action)return;if(['prep','cook'].includes(id)&&heldMeal(state)){toast('Place or store the carried meal first.');return;}const p=()=>getPlayer().position,j=state.homeLife.job;
 if(id==='fridge'||id==='cupboard'){
  let html='<strong>'+(id==='fridge'?'Fridge':'Dry-food cupboard')+'</strong>';for(const [key,info] of Object.entries(INGREDIENTS)){if(info.store!==id&&state.homeLife.ingredients[id][key]===0)continue;html+='<div class="home-stock-row">'+ingredientImage(key)+'<span>'+info.name+' · '+state.homeLife.ingredients[id][key]+' stored / '+state.homeLife.ingredients.bag[key]+' in bag</span><button id="put-'+key+'">Store 1</button><button id="take-'+key+'">Take 1</button>'+(j?.stage==='collect'&&RECIPES[j.recipe].needs[key]&&!j.reserved[key]?'<button id="collect-'+key+'">For recipe</button>':'')+'</div>';}
  if(id==='fridge'){const held=heldMeal(state);if(held)html+='<button id="store-leftover">Store carried meal / leftovers</button>';for(const m of activeMeals(state).filter(m=>m.place==='fridge'))html+='<button class="food-mini-card" id="carry-'+m.id+'">'+foodImage(m.recipe)+'Take '+NUTRITION[m.recipe].name+' · '+(4-m.bites)+'/4 remaining</button>';}
  openPanel(id,html);for(const key of Object.keys(INGREDIENTS)){if(!$('put-'+key))continue;const serial=state.homeLife.stockSerial;$('put-'+key).onclick=()=>{result(moveIngredient(state,key,'bag',id,serial,location(),p()));openStation(id);};$('take-'+key).onclick=()=>{result(moveIngredient(state,key,id,'bag',serial,location(),p()));openStation(id);};if($('collect-'+key))$('collect-'+key).onclick=()=>{result(collectIngredient(state,j.id,key,id,location(),p()));openStation(id);};}if($('store-leftover'))$('store-leftover').onclick=()=>{result(storeMeal(state,heldMeal(state)?.id,'fridge',location(),p()));openStation(id);};for(const m of activeMeals(state).filter(m=>m.place==='fridge'))if($('carry-'+m.id))$('carry-'+m.id).onclick=()=>{result(carryMeal(state,m.id,location(),p()));openStation(id);};return;
 }
 if(id==='prep'){
  if(kitchenActive(state)){if(j.stage==='prepare'){const expected=j.chops;start('prepare','Chop & prepare '+(j.chops+1)+'/3','prep',1.2,()=>prepareRecipe(state,j.id,expected,location(),p()));return;}if(j.stage==='plate'){start('plate','Plating your meal','prep',1.5,()=>plateRecipe(state,j.id,location(),p()));return;}let html='<strong>'+RECIPES[j.recipe].name+' · '+j.stage+'</strong>';if(j.stage==='collect')for(const key of Object.keys(RECIPES[j.recipe].needs))html+='<p>'+ingredientImage(key)+INGREDIENTS[key].name+': '+(j.reserved[key]?'collected':state.homeLife.ingredients.bag[key]?'in bag':'collect from '+INGREDIENTS[key].store)+'</p>'+(!j.reserved[key]&&state.homeLife.ingredients.bag[key]?'<button id="bag-'+key+'">Collect '+INGREDIENTS[key].name+'</button>':'');html+='<button id="cancel-recipe">Cancel recipe</button>';openPanel(id,html);for(const key of Object.keys(RECIPES[j.recipe].needs))if($('bag-'+key))$('bag-'+key).onclick=()=>{result(collectIngredient(state,j.id,key,'bag',location(),p()));openStation(id);};$('cancel-recipe').onclick=()=>{result(cancelRecipe(state,j.id));openStation(id);};return;}
  let html='<strong>Prepare a recipe</strong><p>'+state.pantry+' unopened grocery portions</p>';for(const [key,recipe] of Object.entries(RECIPES)){const a=recipeAvailability(state,key);html+='<div class="home-recipe">'+foodImage(recipe.meal)+'<b>'+recipe.name+'</b><small>'+a.map(i=>i.name+' '+i.have+'/'+i.need+(i.have<i.need?' missing':'')).join(' · ')+'</small><button id="unpack-'+key+'">Unpack 1 grocery portion</button><button id="recipe-'+key+'" '+(a.some(i=>i.have<i.need)?'disabled':'')+'>Select recipe</button></div>';}
  openPanel(id,html);for(const key of Object.keys(RECIPES)){const stock=state.homeLife.stockSerial,serial=state.daily.cookSerial;$('unpack-'+key).onclick=()=>{result(unpackGroceries(state,key,stock));openStation(id);};$('recipe-'+key).onclick=()=>{result(beginRecipe(state,key,serial,location(),p()));openStation(id);};}return;
 }
 if(id==='cook'){if(!kitchenActive(state)||j.stage!=='cook'){toast(kitchenActive(state)?'Next: '+j.stage+' at the correct station.':'Select a recipe at the preparation counter first.');return;}start('cook','Simmer · green heat 55–75','cook',100,null);return;}
 if(id==='table'){const held=heldMeal(state),meal=tableMeal(state);if(held){result(placeMeal(state,held.id,location(),p()));return;}if(meal&&!meal.opened){start('open-meal','Opening the food package','table',1,()=>openMeal(state,meal.id,location(),p()));return;}if(meal){const expected=meal.bites;start('eat','Eating · bite '+(expected+1)+'/4','table',1.6,()=>biteMeal(state,meal.id,expected,location(),p()));return;}openPanel(id,'<strong>Dining table</strong><p>Carry a meal here to place, open and eat it.</p>');}
 }

 function mealActions(){const m=heldMeal(state)||(near('table')?tableMeal(state):null);if(!m||m.serviceOrder||action){mealUI.classList.add('hidden');mealKey='';return;}const key=[m.id,m.phase,m.bites,m.opened,location(),near('table')].join(':');mealUI.classList.remove('hidden');if(key===mealKey)return;mealKey=key;mealUI.innerHTML=foodImage(m.recipe)+'<strong>'+NUTRITION[m.recipe].name+' · '+(4-m.bites)+'/4 left</strong><button id="meal-eat">'+(m.opened?'Eat':'Open')+'</button><button id="meal-serve">Serve</button><button id="meal-store">Store</button><button id="meal-carry">Carry</button>';
 $('meal-eat').onclick=()=>{if(!near('table')){toast('Bring your meal to the home dining table to sit and eat.');return;}if(heldMeal(state)){if(!result(placeMeal(state,m.id,location(),getPlayer().position)))return;}openStation('table');};
 $('meal-serve').onclick=()=>{if(!near('table')){toast('Approach your home table to serve this plate.');return;}result(placeMeal(state,m.id,location(),getPlayer().position));mealKey='';};
 $('meal-store').onclick=()=>{result(storeMeal(state,m.id,'bag',location(),getPlayer().position));mealKey='';};
 $('meal-carry').disabled=m.phase==='carried';$('meal-carry').onclick=()=>{result(carryMeal(state,m.id,location(),getPlayer().position));mealKey='';};
 }
 $('home-cancel').onclick=cancel;$('home-details').onclick=()=>{const j=state.homeLife.job;openPanel(action?.station||'table','<strong>'+(action?.title||'At home')+'</strong><p>'+(action?.kind==='cook'?'Keep heat 55–75 for two seconds, stir twice and simmer eight seconds. Pause keeps the pot.':'Cancel leaves meals and reserved recipe ingredients intact. Completed bites reward only their consumed portion.')+'</p>'+(kitchenActive(state)?'<button id="cancel-recipe">Discard/cancel recipe</button>':''));if($('cancel-recipe'))$('cancel-recipe').onclick=()=>{cancel();result(cancelRecipe(state,j.id));closePanel();};};
 return {props,busy:()=>!!action,safePosition:()=>action?.stand,closePanel,pauseAudio:()=>sound(false),start:startActivity,select:startActivity,openStation,cancel,stop(){if(action){action.complete=null;finish();}closePanel();sound(false);},context(view,p){if(view!=='home'||action)return null;const candidates=Object.entries(HOME_STATIONS).filter(([id])=>id!=='wardrobe'&&(id!=='sit'||state.furniture)).map(([id,s])=>({id,d:Math.hypot(p.x-s.stand.x,p.z-s.stand.z)})).sort((a,b)=>a.d-b.d);const next=candidates[0];if(!next||next.d>1.05)return null;return {id:'home-'+next.id,label:({prep:kitchenActive(state)?'Recipe · '+state.homeLife.job.stage:'Choose recipe / groceries',cook:'Use cooker',fridge:'Open fridge',cupboard:'Open cupboard',table:heldMeal(state)?'Place meal':tableMeal(state)?tableMeal(state).opened?'Sit & eat':'Open meal':'Dining table',wash:'Enter shower',study:'Sit & read',computer:'Sit & type',sleep:'Sleep',sit:'Sit & relax'})[next.id],run:()=>startActivity(next.id)};},tick(dt){mealActions();clock+=dt;const p=getPlayer();if(panel&&(!near(panel)||location()!=='home'))closePanel();if(action){const a=action;a.elapsed+=dt;if(a.kind==='wash'){const entry=1.2,inside=new T.Vector3(5.5,.16,2.8),standing=new T.Vector3(a.stand.x,.16,a.stand.z);if(a.elapsed<entry){p.position.copy(standing).lerp(inside,a.elapsed/entry);animateCharacter(p,dt,true);}else if(a.elapsed>a.duration-entry){p.position.copy(inside).lerp(standing,(a.elapsed-(a.duration-entry))/entry);animateCharacter(p,dt,true);}else{p.position.copy(inside);homeMotion(p,'wash',dt,a.elapsed);}const running=a.elapsed>=entry&&a.elapsed<a.duration-entry;interior.activityTick(running?'wash':null,clock);sound(running);}else if(a.kind==='shower-exit'){p.position.copy(a.from).lerp(new T.Vector3(a.stand.x,.16,a.stand.z),Math.min(1,a.elapsed/a.duration));animateCharacter(p,dt,true);interior.activityTick(null,0);}else{if(a.kind==='cook'){heatRecipe(state,dt);homeMotion(p,state.homeLife.job.sinceStir<1.5?'stir':'cook',dt,a.elapsed);}else homeMotion(p,a.kind,dt,a.elapsed);interior.activityTick(a.kind,clock);}if(a.kind!=='cook'&&a.elapsed>=a.duration)finish();if(clock-lastUI>.15){refresh();lastUI=clock;}if(Math.floor(clock)!==Math.floor(clock-dt))save();}else if(heldMeal(state)||kitchenActive(state)&&!state.homeLife.job.spent&&Object.keys(state.homeLife.job.reserved).length)carryMotion(p);props.update(state,p,location(),action,panel);},get action(){return action;},get panel(){return panel;}};
}
